# SmartFitCoach — Variables d'environnement locales
# Copier ce fichier en .env et remplir les valeurs réelles.
# JAMAIS committer le fichier .env (listé dans .gitignore).

# YouTube Data API v3 — utilisée par scripts/generate-video-registry.js et validate-video-registry.js
# Obtenir une clé : https://console.cloud.google.com/apis/credentials
# Activer l'API : YouTube Data API v3
# Quota free tier : 10 000 unités/jour (search=100 unités, videos.list=1 unité/50 IDs)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
