node_modules/
.DS_Store
playwright-report/
test-results/
*.log
.claude/worktrees/
.netlify/
# Scripts de contre-audit Playwright (temporaires, cleanup automatique)
test-*.js
audit-*.js
audit-*.sh
!test/**/*.js

# Local Netlify folder
.netlify

# Generated bundle (built at deploy time by scripts/build-bundle.js)
app/bundle.js

# Secrets — NEVER commit API keys or credentials
.env
.env.local
*.key
*.pem
.vapid-keys*

# YouTube API registry artifacts (intermédiaires de build — merger dans exercise-videos.js puis supprimer)
registry-output*.json
registry-output*.js
registry-muscu*.json
registry-muscu*.js
registry-combined*.js
registry-checkpoint*.json

# Capacitor native projects
# android/ — regenerated by `npx cap add android`, not tracked
android/
# ios/ — tracked so PrivacyInfo, Info.plist, icons and Xcode project are preserved
# ios/

# Android binaries — exception: the release APK is tracked directly
*.aab
*.keystore

# The release APK is committed so Netlify can serve it
!app/smartfitcoach.apk
